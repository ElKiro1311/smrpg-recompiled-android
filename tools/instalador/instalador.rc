// Recursos del instalador: el icono del port, el manifiesto (estilo de Windows 10/11, DPI por monitor, sin pedir
// permisos de administrador) y la versión (INSTALADOR_VERSION_NUM, de VERSIONES.txt vía el Makefile).
#include <winver.h>
#ifndef INSTALADOR_VERSION_NUM
#define INSTALADOR_VERSION_NUM 0,0,0,0
#endif
#ifndef INSTALADOR_VERSION_STR
#define INSTALADOR_VERSION_STR "0.0.0"
#endif

1 ICON "icon.ico"
1 24 "instalador.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION INSTALADOR_VERSION_NUM
PRODUCTVERSION INSTALADOR_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName", "smrpg-recomp"
            VALUE "FileDescription", "Instalador de SMRPG Recomp"
            VALUE "FileVersion", INSTALADOR_VERSION_STR
            VALUE "ProductName", "SMRPG Recomp"
            VALUE "ProductVersion", INSTALADOR_VERSION_STR
            VALUE "OriginalFilename", "SMRPG-Recomp-Instalador.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
