// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"
// The application manifest (RT_MANIFEST 24, ID 1): UTF-8 as the process code page - a game files folder, or LAS Recomp's
// own folder, named with non-ASCII characters wasn't found (fopen and friends read paths in the system code page)
1 24 "windows.manifest"
// (SMRPG) Nombre y versión para el Explorador y el Administrador de tareas (FileDescription). SMRPG_VERSION: la primera
// entrada de VERSIONES.txt (Makefile, windres -D).
#ifndef SMRPG_VERSION
#define SMRPG_VERSION 0
#endif
#define SMRPG_STR2(x) #x
#define SMRPG_STR(x) SMRPG_STR2(x)
1 VERSIONINFO
FILEVERSION 0, SMRPG_VERSION, 0, 0
PRODUCTVERSION 0, SMRPG_VERSION, 0, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "smrpg-recomp"
      VALUE "FileDescription", "SMRPG Recomp"
      VALUE "FileVersion", "0." SMRPG_STR(SMRPG_VERSION)
      VALUE "InternalName", "smrpg-recomp"
      VALUE "OriginalFilename", "smrpg-recomp.exe"
      VALUE "ProductName", "SMRPG Recomp"
      VALUE "ProductVersion", "0." SMRPG_STR(SMRPG_VERSION)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
